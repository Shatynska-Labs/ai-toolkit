#!/usr/bin/env bash
# Deterministic project initialization for the ai-toolkit development
# workflow. See `--help` for usage; see tests/README.md for the report
# contract this script implements against.
set -u

# Inherited from a hook or wrapper, these would point every git call below at
# the caller's repository instead of the target.
if command -v git >/dev/null 2>&1; then
  # shellcheck disable=SC2046 # word splitting is intended: one name per word
  unset $(git rev-parse --local-env-vars 2>/dev/null)
fi
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

print_help() {
  cat <<'HELP'
project-init — deterministic project initialization for the ai-toolkit development workflow

Usage:
  project-init [--tools <value>] [--help|-h] [TARGET_DIR]

Modes (derived automatically, never flagged):
  new project  — TARGET_DIR's repository has no commit yet. Ends by naming
                 foundation discovery as the next step.
  adoption     — TARGET_DIR's repository has at least one commit. Ends at
                 the managed blocks; no foundation change is created.

Managed blocks (rules/manifest lists them, each read from rules/<name>.md):
  development-workflow   into AGENTS.md
  backlog                into docs/backlog/AGENTS.md
  workstreams            into docs/workstreams/AGENTS.md
  Each opening marker carries the fragment's version and the SHA-256 of what
  was written. A directory's CLAUDE.md is created holding @AGENTS.md where
  absent; a directory holding its rules in README.md is reported, not
  converted. A block already present is never rewritten: scripts/project-update
  brings an older one current and converts a README.

Arguments:
  TARGET_DIR   Directory to initialize. Defaults to the current working
               directory if omitted.

Flags:
  --tools <value>   Specification-tooling target, passed through to
                     `openspec init --tools <value>`. Default: claude.
  --help, -h        Show this help and exit. Makes no filesystem change.

Outcomes and exit codes:
  0   SUCCESS   every applicable concern was completed or already satisfied
  1   ERROR     a step was attempted and failed
  2   BLOCKED   a precondition was unmet; no filesystem change was attempted

Never overwrites a file it did not create, except appending a managed
block into an AGENTS.md the manifest names. Never commits. Never starts foundation
discovery — only names it as the next step.
HELP
}

# --- Self-location: never resolved from the environment. -------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$TOOLKIT_ROOT/rules/manifest"

# --- Argument parsing --------------------------------------------------------
target=""
tools="claude"
show_help=0

while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h)
      show_help=1
      shift
      ;;
    --tools)
      tools="${2:-}"
      shift 2
      ;;
    --tools=*)
      tools="${1#--tools=}"
      shift
      ;;
    *)
      if [ -z "$target" ]; then
        target="$1"
      fi
      shift
      ;;
  esac
done

if [ "$show_help" -eq 1 ]; then
  print_help
  exit 0
fi

if [ -z "$target" ]; then
  target="$(pwd)"
fi

# --- Terminal-outcome helpers -------------------------------------------------
finish_blocked() {
  echo "Outcome: BLOCKED"
  echo "Reason: $1"
  exit 2
}

finish_error() {
  echo "Outcome: ERROR"
  echo "Reason: $1"
  exit 1
}

# --- Target validation, reported before anything else -----------------------
if [ -d "$target" ]; then
  target="$(CDPATH='' cd -- "$target" && pwd)"
  # git rev-parse --show-toplevel resolves symlinks, so the repository check
  # compares against the physical path; the report keeps the path as given.
  target_physical="$(CDPATH='' cd -- "$target" && pwd -P)"
else
  target_physical="$target"
fi
echo "Target: $target"

if [ ! -e "$target" ]; then
  finish_blocked "target directory does not exist: $target"
fi
if [ ! -d "$target" ]; then
  finish_blocked "target is not a directory: $target"
fi
if [ ! -w "$target" ]; then
  finish_blocked "target directory is not writable: $target"
fi

# --- The manifest and every fragment it lists are read unconditionally, ----
# --- before any other precondition. ----------------------------------------
if [ ! -f "$MANIFEST" ]; then
  finish_blocked "manifest not found at $MANIFEST"
fi

# One record per block, records separated by `---`: its name (the fragment
# rules/<name>.md and the marker's name) and its target, an AGENTS.md
# relative to the project root.
manifest_records="$(awk '
  function out() { if (n != "" || t != "") print n "\t" t; n = ""; t = "" }
  /^---[[:space:]]*$/ { out(); next }
  /^name:/ { sub(/^name:[[:space:]]*/, ""); n = $0; next }
  /^target:/ { sub(/^target:[[:space:]]*/, ""); t = $0; next }
  END { out() }
' "$MANIFEST")"

rec_name=()
rec_target=()
rec_version=()
rec_body=()
while IFS="$(printf '\t')" read -r name tgt; do
  [ -n "$name$tgt" ] || continue
  if ! printf '%s\n' "$name" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
    finish_blocked "manifest at $MANIFEST has a record without a kebab-case name: '$name'"
  fi
  case "$tgt" in
    AGENTS.md|*/AGENTS.md) ;;
    *) finish_blocked "manifest record $name targets '$tgt', not an AGENTS.md" ;;
  esac
  case "/$tgt/" in
    //*|*/../*|*/./*) finish_blocked "manifest record $name targets '$tgt', not a path inside the project" ;;
  esac
  frag="$TOOLKIT_ROOT/rules/$name.md"
  if [ ! -f "$frag" ]; then
    finish_blocked "rule fragment $name, listed in the manifest, not found at $frag"
  fi
  if [ "$(head -n 1 "$frag")" != "---" ]; then
    finish_blocked "rule fragment at $frag has no frontmatter"
  fi
  frontmatter="$(sed -n '2,/^---$/p' "$frag" | sed '$d')"
  kind="$(printf '%s\n' "$frontmatter" | sed -n 's/^kind:[[:space:]]*//p' | head -n1)"
  version="$(printf '%s\n' "$frontmatter" | sed -n 's/^version:[[:space:]]*//p' | head -n1)"
  if [ -z "$kind" ] || ! printf '%s\n' "$version" | grep -qE '^[0-9]+[.][0-9]+[.][0-9]+$'; then
    finish_blocked "rule fragment at $frag is missing kind, or a version of the form MAJOR.MINOR.PATCH"
  fi
  closing_line="$(grep -n '^---$' "$frag" | sed -n '2p' | cut -d: -f1)"
  if [ -z "$closing_line" ]; then
    finish_blocked "rule fragment at $frag has no closing frontmatter delimiter"
  fi
  rec_name+=("$name")
  rec_target+=("$tgt")
  rec_version+=("$version")
  rec_body+=("$(tail -n "+$((closing_line + 1))" "$frag")")
done <<EOF_RECORDS
$manifest_records
EOF_RECORDS

if [ "${#rec_name[@]}" -eq 0 ]; then
  finish_blocked "manifest at $MANIFEST lists no block"
fi

# The version an opening marker records, in either form:
# `<!-- ai-toolkit:<name> <version> sha256:<hash> -->` or the earlier
# `<!-- ai-toolkit:<name> v<N> -->`. Empty where the file holds no block.
block_version() {
  grep -m1 "^<!-- ai-toolkit:$2 " "$1" 2>/dev/null | sed -n "s/^<!-- ai-toolkit:$2 \([^ ]*\) .*/\1/p"
}
# Whether the file holds an opening marker for $2 at all, in any form: the
# prefix scripts/project-update reads presence by, so the two tools agree.
block_present() {
  grep -q "^<!-- ai-toolkit:$2 " "$1" 2>/dev/null
}
# Compares two versions, each MAJOR.MINOR.PATCH or the earlier v<N>, which is
# below every semantic version: prints -1, 0 or 1, or nothing where either is
# in neither form.
version_cmp() {
  local a="$1" b="$2" a1 a2 a3 b1 b2 b3
  case "$a" in v[0-9]*) a="-1.$(printf '%s' "${a#v}" | sed 's/^0*\([0-9]\)/\1/').0" ;; esac
  case "$b" in v[0-9]*) b="-1.$(printf '%s' "${b#v}" | sed 's/^0*\([0-9]\)/\1/').0" ;; esac
  printf '%s\n%s\n' "$a" "$b" | grep -qvE '^-?[0-9]+[.][0-9]+[.][0-9]+$' && return 0
  IFS=. read -r a1 a2 a3 <<EOF_A
$a
EOF_A
  IFS=. read -r b1 b2 b3 <<EOF_B
$b
EOF_B
  awk -v a1="$a1" -v a2="$a2" -v a3="$a3" -v b1="$b1" -v b2="$b2" -v b3="$b3" 'BEGIN {
    if (a1 + 0 != b1 + 0) { print (a1 + 0 < b1 + 0) ? -1 : 1; exit }
    if (a2 + 0 != b2 + 0) { print (a2 + 0 < b2 + 0) ? -1 : 1; exit }
    if (a3 + 0 != b3 + 0) { print (a3 + 0 < b3 + 0) ? -1 : 1; exit }
    print 0 }'
}
# The parenthesis a report line gives a block already present.
present_detail() {
  case "$(version_cmp "$1" "$2")" in
    0) echo "version $1, matches" ;;
    -1) echo "existing version $1, tool carries version $2; bring it current with $SCRIPT_DIR/project-update" ;;
    1) echo "existing version $1, tool carries version $2; the block is ahead of this toolkit" ;;
    *) echo "existing version '$1', tool carries version $2; the marker is malformed, see $SCRIPT_DIR/project-update" ;;
  esac
}
# --- Determine which concerns are outstanding (filesystem reads only). ------
repo_root="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null || true)"
if [ "$repo_root" = "$target_physical" ]; then
  repo_outstanding=0
  if git -C "$target" rev-parse HEAD >/dev/null 2>&1; then
    has_commit=1
  else
    has_commit=0
  fi
else
  repo_outstanding=1
  has_commit=0
fi

if [ -f "$target/openspec/config.yaml" ]; then
  spec_outstanding=0
else
  spec_outstanding=1
fi

# A dangling link at the ignore file counts as present: writing to it would
# follow it.
if [ -e "$target/.gitignore" ] || [ -L "$target/.gitignore" ]; then
  gitignore_outstanding=0
else
  gitignore_outstanding=1
fi

agents_path="$target/AGENTS.md"
claude_path="$target/CLAUDE.md"

# Each manifest record's state. The root's AGENTS.md is the project's own
# file: a link there is written through, as it always was. A seeded
# directory's target is never written through a link or into a path that is
# not what the tool would write there, and a directory still holding its
# rules in README.md is reported rather than written beside.
rec_state=()
rec_existing=()
rec_detail=()
block_outstanding=0
for i in "${!rec_name[@]}"; do
  tgt="${rec_target[$i]}"
  state=""
  existing=""
  detail=""
  if [ "$tgt" = "AGENTS.md" ]; then
    if [ -f "$target/AGENTS.md" ]; then
      existing="$(block_version "$target/AGENTS.md" "${rec_name[$i]}")"
      if block_present "$target/AGENTS.md" "${rec_name[$i]}"; then state="present"; else state="append"; fi
    else
      state="create"
    fi
  else
    dir="${tgt%/*}"
    if [ "${rec_name[$i]}" = "backlog" ] && [ "$dir" = "docs/backlog" ] \
      && [ ! -e "$target/docs/backlog" ] && [ ! -L "$target/docs/backlog" ] \
      && { [ -e "$target/docs/backlog.md" ] || [ -L "$target/docs/backlog.md" ]; }; then
      state="single-file"
    fi
    dir_existed=0
    if [ -z "$state" ]; then
      p="$target/$dir"
      if [ -L "$p" ] || { [ -e "$p" ] && [ ! -d "$p" ]; }; then
        state="bad-dir"
        detail="$dir"
      elif [ -d "$p" ]; then
        dir_existed=1
      fi
    fi
    if [ -z "$state" ]; then
      tf="$target/$tgt"
      if [ -L "$tf" ] || { [ -e "$tf" ] && [ ! -f "$tf" ]; }; then
        state="bad-target"
      else
        [ -f "$tf" ] && existing="$(block_version "$tf" "${rec_name[$i]}")"
        if [ -f "$tf" ] && block_present "$tf" "${rec_name[$i]}"; then
          state="present"
        elif [ -e "$target/$dir/README.md" ] || [ -L "$target/$dir/README.md" ]; then
          state="legacy"
        elif [ -f "$tf" ]; then
          state="append"
        elif [ "$dir_existed" -eq 1 ]; then
          state="create-beside"
        else
          state="create"
        fi
      fi
    fi
  fi
  case "$state" in
    create|create-beside|append) block_outstanding=1 ;;
  esac
  rec_state+=("$state")
  rec_existing+=("$existing")
  rec_detail+=("$detail")
done
# --- External-command preconditions, scoped to outstanding concerns only. ---
if [ "$repo_outstanding" -eq 1 ] && ! command -v git >/dev/null 2>&1; then
  finish_blocked "git not found, required to initialize the repository"
fi
if [ "$spec_outstanding" -eq 1 ] && ! command -v openspec >/dev/null 2>&1; then
  finish_blocked "openspec not found, required to initialize specification tooling"
fi
hash_cmd=""
if command -v sha256sum >/dev/null 2>&1; then
  hash_cmd="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  hash_cmd="shasum"
fi
if [ "$block_outstanding" -eq 1 ] && [ -z "$hash_cmd" ]; then
  finish_blocked "neither sha256sum nor shasum found, required to hash a managed block"
fi

# --- Attempt each outstanding concern, in order. No rollback on failure. ----
if [ "$repo_outstanding" -eq 1 ]; then
  # Only a .git that is absent or empty is the tool's to give a branch: one
  # with any content may be a repository the check above could not read.
  had_git_content=0
  if [ -e "$target/.git" ]; then
    # An unreadable .git counts as having content.
    git_dir_listing="$(ls -A "$target/.git" 2>/dev/null)" || had_git_content=1
    [ -n "$git_dir_listing" ] && had_git_content=1
  fi
  if ! git -C "$target" init -q >/dev/null 2>&1; then
    finish_error "repository: git init failed"
  fi
  # Set the initial branch explicitly: before git 2.28, git init ignores
  # init.defaultBranch and always starts on master.
  if [ "$had_git_content" -eq 0 ]; then
    initial_branch="$(git -C "$target" config --get init.defaultBranch 2>/dev/null)"
    [ -n "$initial_branch" ] || initial_branch="main"
    if ! git -C "$target" check-ref-format --branch "$initial_branch" >/dev/null 2>&1 \
      || ! git -C "$target" symbolic-ref HEAD "refs/heads/$initial_branch" >/dev/null 2>&1; then
      finish_error "repository: initial branch could not be set to '$initial_branch'; set it with \`git symbolic-ref HEAD refs/heads/<branch>\` in the target, then re-run to complete the remaining steps"
    fi
  fi
  echo "repository: created"
  has_commit=0
else
  echo "repository: already present"
fi

if [ "$spec_outstanding" -eq 1 ]; then
  if ! openspec init --tools "$tools" --no-animation "$target" >/dev/null 2>&1; then
    finish_error "specification tooling: openspec init --tools $tools failed"
  fi
  echo "specification tooling: created via \`openspec init --tools $tools\`"
else
  echo "specification tooling: already present"
fi

if [ "$gitignore_outstanding" -eq 1 ]; then
  if ! cat > "$target/.gitignore" <<'GITIGNORE'
# Environment
.env
.env.*
!.env.example

# OS
.DS_Store
Thumbs.db

# Editors
.idea/
.vscode/

# Working trees
.worktrees/
.claude/worktrees/
GITIGNORE
  then
    finish_error "ignore file: could not be written"
  fi
  echo "ignore file: created"
else
  echo "ignore file: already present"
fi

# A block for record $1: the opening marker carries the fragment's version and
# the SHA-256 of every line between the markers, the notice and the body.
build_block() {
  local inner hash
  inner="$(printf '%s\n' \
    "<!-- Generated. Do not edit inside this block — it is replaced on update." \
    "     Project-specific conventions belong outside the markers. -->" \
    "${rec_body[$1]}")"
  if [ "$hash_cmd" = "sha256sum" ]; then
    hash="$(printf '%s\n' "$inner" | sha256sum | cut -d' ' -f1)"
  else
    hash="$(printf '%s\n' "$inner" | shasum -a 256 | cut -d' ' -f1)"
  fi
  echo "<!-- ai-toolkit:${rec_name[$1]} ${rec_version[$1]} sha256:$hash -->"
  printf '%s\n' "$inner"
  echo "<!-- /ai-toolkit:${rec_name[$1]} -->"
}

# The report keeps one order whatever order the blocks are written in: each
# seeded directory's line, then the conventions file's, then the directories'
# imports. A failed write prints what was gathered before its own outcome.
dir_lines=""
root_line=""
import_lines=""
report_line() { eval "$1=\"\${$1}\$2
\""; }
flush_report() {
  printf '%s' "$dir_lines$root_line$import_lines"
}
fail_record() {
  flush_report
  finish_error "$1"
}
claude_has_import=0
if [ -f "$claude_path" ] && grep -qF '@AGENTS.md' "$claude_path" 2>/dev/null; then
  claude_has_import=1
fi

# Claude Code reads AGENTS.md on its own only where no project instructions
# file is found for the target, in it or any directory above it; the user's
# own ~/.claude/CLAUDE.md does not count.
shadowed=0
home_instructions="${HOME%/}/.claude/CLAUDE.md"
# Both the path as given and its physical form, so a symlinked target cannot
# hide a shadowing file on either chain.
for start in "$target" "$target_physical"; do
  dir="$start"
  while :; do
    for candidate in "${dir%/}/CLAUDE.md" "${dir%/}/CLAUDE.local.md" "${dir%/}/.claude/CLAUDE.md"; do
      [ "$candidate" = "$home_instructions" ] && continue
      if [ -e "$candidate" ]; then
        shadowed=1
      fi
    done
    [ "$shadowed" -eq 1 ] && break 2
    [ "$dir" = "/" ] && break
    dir="$(dirname "$dir")"
  done
done

import_needed=0

for i in "${!rec_name[@]}"; do
  name="${rec_name[$i]}"
  tgt="${rec_target[$i]}"
  version="${rec_version[$i]}"
  existing="${rec_existing[$i]}"
  if [ "$tgt" = "AGENTS.md" ]; then
    case "${rec_state[$i]}" in
      present)
        report_line root_line "conventions file: block already present ($(present_detail "$existing" "$version"))"
        ;;
      append)
        { echo ""; build_block "$i"; } >> "$agents_path" || fail_record "conventions file: could not append the managed block"
        report_line root_line "conventions file: block appended (version $version)"
        ;;
      create)
        build_block "$i" > "$agents_path" || fail_record "conventions file: could not be created"
        report_line root_line "conventions file: created with block (version $version)"
        ;;
    esac
    [ "$claude_has_import" -eq 0 ] && import_needed=1
    continue
  fi

  dir="${tgt%/*}"
  case "${rec_state[$i]}" in
    single-file)
      report_line dir_lines "$name: present as the single file docs/backlog.md; convert it with scripts/backlog-migrate"
      continue
      ;;
    bad-dir)
      report_line dir_lines "$name: ${rec_detail[$i]} is not a directory the tool writes into; nothing written"
      continue
      ;;
    bad-target)
      report_line dir_lines "$name: $tgt is not a file the tool writes into; nothing written"
      continue
      ;;
    legacy)
      report_line dir_lines "$name: rules present as $dir/README.md, the shape before 1.0.0 (tool carries version $version); convert it with $SCRIPT_DIR/project-update, nothing written"
      continue
      ;;
    present)
      report_line dir_lines "$name: already present ($(present_detail "$existing" "$version"))"
      ;;
    append)
      { echo ""; build_block "$i"; } >> "$target/$tgt" 2>/dev/null || fail_record "$name: could not append the managed block to $tgt"
      report_line dir_lines "$name: block appended to $tgt (version $version)"
      ;;
    create|create-beside)
      if ! mkdir -p "$target/$dir" 2>/dev/null || ! build_block "$i" > "$target/$tgt" 2>/dev/null; then
        fail_record "$name: $tgt could not be written"
      fi
      if [ "${rec_state[$i]}" = "create" ]; then
        report_line dir_lines "$name: created"
      elif [ "$name" = "backlog" ]; then
        report_line dir_lines "$name: created beside existing entries"
      else
        report_line dir_lines "$name: created beside existing files"
      fi
      ;;
  esac

  # The directory's CLAUDE.md imports its AGENTS.md, which a root CLAUDE.md
  # otherwise keeps from loading. A path of any type there is the project's.
  dir_claude="$target/$dir/CLAUDE.md"
  if [ ! -e "$dir_claude" ] && [ ! -L "$dir_claude" ]; then
    printf '%s\n' '@AGENTS.md' > "$dir_claude" 2>/dev/null || fail_record "$name: $dir/CLAUDE.md could not be written"
    report_line import_lines "directory import: $dir/CLAUDE.md created holding @AGENTS.md"
  elif ! { [ -f "$dir_claude" ] && grep -qxF '@AGENTS.md' "$dir_claude" 2>/dev/null; }; then
    report_line import_lines "directory import: add the line @AGENTS.md to $dir/CLAUDE.md for $tgt to load"
  fi
done

flush_report
if [ "$import_needed" -eq 1 ]; then
  # shellcheck disable=SC2016 # single-quoted deliberately: the backticks are
  # literal formatting, not command substitution, and no variable expansion
  # is wanted in these strings.
  if [ "$shadowed" -eq 1 ]; then
    echo 'Import needed: add `@AGENTS.md` to this project'"'"'s own CLAUDE.md (create it if absent) for the rules to take effect'
  else
    echo 'Note: Claude Code reads AGENTS.md without a CLAUDE.md from version 2.1.277 (2.1.281 on Bedrock, Vertex AI, Foundry, gateways and telemetry-disabled sessions), unless its "Project instructions" setting says otherwise; on an earlier version, add `@AGENTS.md` to a CLAUDE.md.'
  fi
fi

echo "Outcome: SUCCESS"

if [ "$has_commit" -eq 1 ]; then
  echo "Next step: none required — foundation discovery is available if you want to record this project's decisions; run /project-foundation."
else
  echo "Next step: foundation discovery — run /project-foundation to establish this project's foundation."
fi

exit 0
