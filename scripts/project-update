#!/usr/bin/env bash
# Brings one project's managed blocks to the text of the library copy this
# script belongs to. See `--help` for usage; see tests/README.md for the
# report contract this script implements against.
set -u

# Inherited from a hook or wrapper, these would point every git call below at
# the caller's repository instead of the target.
if command -v git >/dev/null 2>&1; then
  # shellcheck disable=SC2046 # word splitting is intended: one name per word
  unset $(git rev-parse --local-env-vars 2>/dev/null)
fi
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE

print_help() {
  cat <<'HELP'
project-update — bring a project's managed blocks to this toolkit's current text

Usage:
  project-update [--help|-h] [TARGET_DIR]

For each block rules/manifest lists, reads the project's copy and reports it
as one of:
  current        at the fragment's version, untouched
  replaced       older and untouched: the lines from its opening to its
                 closing marker are rewritten, nothing outside them
  edited         its hash no longer matches what lies between the markers:
                 reported with a diff, never overwritten
  ahead          newer than this toolkit's fragment: not written
  malformed      markers unreadable: not written
  converted      the shape before 1.0.0 — a v<N> block, or a directory's
                 rules in README.md — converted once, and only where every
                 file it touches is committed and unmodified, so git diff
                 shows the conversion and git restore undoes it
  absent         no block: scripts/project-init writes it
  single file    the backlog as docs/backlog.md: scripts/backlog-migrate
                 converts it
Records left edited, ahead, malformed, unwritable, absent or single file are
named on a final Attention: line.

Arguments:
  TARGET_DIR   The project's root. Defaults to the current working directory.

Flags:
  --help, -h   Show this help and exit. Makes no filesystem change.

Outcomes and exit codes:
  0   SUCCESS   every record was handled as above
  1   ERROR     a write was attempted and failed; the files written are listed
  2   BLOCKED   a precondition was unmet; nothing was written

Never commits. Never writes a block the project does not hold.
HELP
}

# --- Self-location: never resolved from the environment. -------------------
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
TOOLKIT_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
MANIFEST="$TOOLKIT_ROOT/rules/manifest"

# --- Argument parsing --------------------------------------------------------
target=""
show_help=0
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) show_help=1 ;;
    *) [ -z "$target" ] && target="$1" ;;
  esac
  shift
done

if [ "$show_help" -eq 1 ]; then
  print_help
  exit 0
fi
[ -n "$target" ] || target="$(pwd)"

finish_blocked() {
  echo "Outcome: BLOCKED"
  echo "Reason: $1"
  exit 2
}

# --- Target validation, reported before anything else -----------------------
if [ -d "$target" ]; then
  target="$(CDPATH='' cd -- "$target" && pwd)"
  target_physical="$(CDPATH='' cd -- "$target" && pwd -P)"
else
  target_physical="$target"
fi
echo "Target: $target"
[ -e "$target" ] || finish_blocked "target directory does not exist: $target"
[ -d "$target" ] || finish_blocked "target is not a directory: $target"
[ -w "$target" ] || finish_blocked "target directory is not writable: $target"

# --- The manifest and every fragment it lists, before anything else. -------
# Read as scripts/project-init reads them; a block built here must equal one
# built there, which tests/cases/project-update-replacement-equals-project-init.sh
# checks.
[ -f "$MANIFEST" ] || finish_blocked "manifest not found at $MANIFEST"

manifest_records="$(awk '
  function out() { if (n != "" || t != "") print n "\t" t; n = ""; t = "" }
  /^---[[:space:]]*$/ { out(); next }
  /^name:/ { sub(/^name:[[:space:]]*/, ""); n = $0; next }
  /^target:/ { sub(/^target:[[:space:]]*/, ""); t = $0; next }
  END { out() }
' "$MANIFEST")"

rec_name=()
rec_target=()
rec_version=()
rec_body=()
while IFS="$(printf '\t')" read -r name tgt; do
  [ -n "$name$tgt" ] || continue
  if ! printf '%s\n' "$name" | grep -qE '^[a-z0-9][a-z0-9-]*$'; then
    finish_blocked "manifest at $MANIFEST has a record without a kebab-case name: '$name'"
  fi
  case "$tgt" in
    AGENTS.md|*/AGENTS.md) ;;
    *) finish_blocked "manifest record $name targets '$tgt', not an AGENTS.md" ;;
  esac
  case "/$tgt/" in
    //*|*/../*|*/./*) finish_blocked "manifest record $name targets '$tgt', not a path inside the project" ;;
  esac
  frag="$TOOLKIT_ROOT/rules/$name.md"
  [ -f "$frag" ] || finish_blocked "rule fragment $name, listed in the manifest, not found at $frag"
  [ "$(head -n 1 "$frag")" = "---" ] || finish_blocked "rule fragment at $frag has no frontmatter"
  frontmatter="$(sed -n '2,/^---$/p' "$frag" | sed '$d')"
  kind="$(printf '%s\n' "$frontmatter" | sed -n 's/^kind:[[:space:]]*//p' | head -n1)"
  version="$(printf '%s\n' "$frontmatter" | sed -n 's/^version:[[:space:]]*//p' | head -n1)"
  if [ -z "$kind" ] || ! printf '%s\n' "$version" | grep -qE '^[0-9]+[.][0-9]+[.][0-9]+$'; then
    finish_blocked "rule fragment at $frag is missing kind, or a version of the form MAJOR.MINOR.PATCH"
  fi
  closing_line="$(grep -n '^---$' "$frag" | sed -n '2p' | cut -d: -f1)"
  [ -n "$closing_line" ] || finish_blocked "rule fragment at $frag has no closing frontmatter delimiter"
  rec_name+=("$name")
  rec_target+=("$tgt")
  rec_version+=("$version")
  rec_body+=("$(tail -n "+$((closing_line + 1))" "$frag")")
done <<EOF_RECORDS
$manifest_records
EOF_RECORDS

[ "${#rec_name[@]}" -gt 0 ] || finish_blocked "manifest at $MANIFEST lists no block"

hash_cmd=""
if command -v sha256sum >/dev/null 2>&1; then
  hash_cmd="sha256sum"
elif command -v shasum >/dev/null 2>&1; then
  hash_cmd="shasum"
fi
[ -n "$hash_cmd" ] || finish_blocked "neither sha256sum nor shasum found, required to hash a managed block"

sha256_stdin() {
  if [ "$hash_cmd" = "sha256sum" ]; then
    sha256sum | cut -d' ' -f1
  else
    shasum -a 256 | cut -d' ' -f1
  fi
}

# The lines a block for record $1 holds between its markers: the notice and
# the fragment's body.
build_inner() {
  printf '%s\n' \
    "<!-- Generated. Do not edit inside this block — it is replaced on update." \
    "     Project-specific conventions belong outside the markers. -->" \
    "${rec_body[$1]}"
}
# A block for record $1, exactly as scripts/project-init's build_block writes it.
build_block() {
  local inner hash
  inner="$(build_inner "$1")"
  hash="$(printf '%s\n' "$inner" | sha256_stdin)"
  echo "<!-- ai-toolkit:${rec_name[$1]} ${rec_version[$1]} sha256:$hash -->"
  printf '%s\n' "$inner"
  echo "<!-- /ai-toolkit:${rec_name[$1]} -->"
}

# Compares two versions, each MAJOR.MINOR.PATCH or the earlier v<N>, which is
# below every semantic version: prints -1, 0 or 1.
version_cmp() {
  local a="$1" b="$2" a1 a2 a3 b1 b2 b3
  case "$a" in v*) a="-1.${a#v}.0" ;; esac
  case "$b" in v*) b="-1.${b#v}.0" ;; esac
  IFS=. read -r a1 a2 a3 <<EOF_A
$a
EOF_A
  IFS=. read -r b1 b2 b3 <<EOF_B
$b
EOF_B
  awk -v a1="$a1" -v a2="$a2" -v a3="$a3" -v b1="$b1" -v b2="$b2" -v b3="$b3" 'BEGIN {
    if (a1 + 0 != b1 + 0) { print (a1 + 0 < b1 + 0) ? -1 : 1; exit }
    if (a2 + 0 != b2 + 0) { print (a2 + 0 < b2 + 0) ? -1 : 1; exit }
    if (a3 + 0 != b3 + 0) { print (a3 + 0 < b3 + 0) ? -1 : 1; exit }
    print 0 }'
}

# For file $1 and record name $2: the number of opening markers (any line
# beginning `<!-- ai-toolkit:<name> `, the prefix project-init reads presence
# by), the first one's line number, and the line number of the first closing
# marker after it, 0 where absent.
scan_markers() {
  awk -v o="<!-- ai-toolkit:$2 " -v c="<!-- /ai-toolkit:$2 -->" '
    index($0, o) == 1 { n++; if (n == 1) ol = NR }
    ol && !cl && NR > ol && $0 == c { cl = NR }
    END { print n + 0, ol + 0, cl + 0 }
  ' "$1"
}
# The lines strictly between line $2 and line $3 of file $1, each with its
# newline.
lines_between() {
  awk -v a="$2" -v b="$3" 'NR > a && NR < b' "$1"
}

# --- Classify every record (filesystem reads only). --------------------------
rec_state=()
rec_file=()    # the file the block is in, or would be written into
rec_have=()    # the version the project's marker carries
rec_open=()
rec_close=()
rec_restore=() # the path git restores for a converted block, where not its target
any_legacy=0
for i in "${!rec_name[@]}"; do
  name="${rec_name[$i]}"
  tgt="${rec_target[$i]}"
  tf="$target/$tgt"
  state=""
  have=""
  ol=0
  cl=0
  if [ "$tgt" = "AGENTS.md" ]; then
    # The root's AGENTS.md is the project's own file: a link there is
    # written through, as project-init appends through it.
    if [ -e "$tf" ] && [ ! -f "$tf" ]; then state="not writable"; fi
  else
    dir="${tgt%/*}"
    p="$target/$dir"
    if [ -L "$p" ] || { [ -e "$p" ] && [ ! -d "$p" ]; }; then
      state="not writable"
    elif [ -L "$tf" ] || { [ -e "$tf" ] && [ ! -f "$tf" ]; }; then
      state="not writable"
    elif [ "$name" = "backlog" ] && [ "$dir" = "docs/backlog" ] && [ ! -e "$p" ] \
      && { [ -e "$target/docs/backlog.md" ] || [ -L "$target/docs/backlog.md" ]; }; then
      state="single file"
    fi
  fi
  if [ -z "$state" ]; then
    count=0
    if [ -f "$tf" ]; then
      read -r count ol cl <<EOF_SCAN
$(scan_markers "$tf" "$name")
EOF_SCAN
    fi
    if [ "$count" -eq 0 ]; then
      if [ "$tgt" != "AGENTS.md" ] && { [ -e "$target/${tgt%/*}/README.md" ] || [ -L "$target/${tgt%/*}/README.md" ]; }; then
        state="legacy README"
      else
        state="absent"
      fi
    else
      opening="$(sed -n "${ol}p" "$tf")"
      if [ "$count" -gt 1 ] || [ "$cl" -eq 0 ]; then
        state="malformed"
      elif printf '%s\n' "$opening" | grep -qE "^<!-- ai-toolkit:$name v[0-9]+ -->\$"; then
        state="legacy block"
        have="$(printf '%s\n' "$opening" | sed -n "s/^<!-- ai-toolkit:$name \\(v[0-9]*\\) -->\$/\\1/p")"
      elif printf '%s\n' "$opening" | grep -qE "^<!-- ai-toolkit:$name [0-9]+[.][0-9]+[.][0-9]+ sha256:[0-9a-f]{64} -->\$"; then
        have="$(printf '%s\n' "$opening" | cut -d' ' -f3)"
        want_hash="$(printf '%s\n' "$opening" | sed 's/.* sha256:\([0-9a-f]*\) -->$/\1/')"
        got_hash="$(lines_between "$tf" "$ol" "$cl" | sha256_stdin)"
        if [ "$want_hash" != "$got_hash" ]; then
          state="edited"
        else
          case "$(version_cmp "$have" "${rec_version[$i]}")" in
            0) state="current" ;;
            1) state="ahead" ;;
            *) state="stale" ;;
          esac
        fi
      else
        state="malformed"
      fi
    fi
  fi
  case "$state" in "legacy block"|"legacy README") any_legacy=1 ;; esac
  rec_state+=("$state")
  rec_file+=("$tf")
  rec_have+=("$have")
  rec_open+=("$ol")
  rec_close+=("$cl")
done

# --- Where a legacy shape is converted, git must hold what it replaces. -----
# Resolves a chain of links to the file it ends at, physically; nothing where
# it does not end at an existing directory, or takes more than eight links.
resolve_link() {
  local p="$1" hops=0 t d
  while [ -L "$p" ]; do
    hops=$((hops + 1))
    [ "$hops" -le 8 ] || return 1
    t="$(readlink "$p")" || return 1
    case "$t" in
      /*) p="$t" ;;
      *) p="$(dirname "$p")/$t" ;;
    esac
  done
  d="$(CDPATH='' cd -P -- "$(dirname "$p")" 2>/dev/null && pwd -P)" || return 1
  printf '%s/%s\n' "$d" "$(basename "$p")"
}
# Blocks unless the path $1, relative to the target, is tracked and identical
# in the working tree and the index to HEAD; $2, where given, is how the
# report names it, such as a link resolving to it.
require_committed() {
  local shown="${2:-$1}"
  git -C "$target" ls-files --error-unmatch -- "$1" >/dev/null 2>&1 \
    || finish_blocked "$shown is not tracked by git; commit it before converting the shape before 1.0.0"
  if ! git -C "$target" diff --quiet -- "$1" 2>/dev/null \
    || ! git -C "$target" diff --cached --quiet -- "$1" 2>/dev/null; then
    finish_blocked "$shown differs from its committed content; commit or restore it before converting the shape before 1.0.0"
  fi
}

if [ "$any_legacy" -eq 1 ]; then
  command -v git >/dev/null 2>&1 || finish_blocked "git not found, required to convert the shape before 1.0.0"
  top="$(git -C "$target" rev-parse --show-toplevel 2>/dev/null || true)"
  [ "$top" = "$target_physical" ] \
    || finish_blocked "the target is not the top level of a git working tree, required to convert the shape before 1.0.0"
  git -C "$target" rev-parse --verify -q HEAD >/dev/null 2>&1 \
    || finish_blocked "the repository has no commit, required to convert the shape before 1.0.0"
  for i in "${!rec_name[@]}"; do
    if [ "${rec_state[$i]}" = "not writable" ] && [ "${rec_target[$i]}" != "AGENTS.md" ]; then
      dir="${rec_target[$i]%/*}"
      if [ -e "$target/$dir/README.md" ] || [ -L "$target/$dir/README.md" ]; then
        finish_blocked "${rec_name[$i]}: $dir holds README.md but is not a path the tool writes into, so its rules cannot be converted in the same run as the others"
      fi
    fi
  done
  for i in "${!rec_name[@]}"; do
    tgt="${rec_target[$i]}"
    case "${rec_state[$i]}" in
      "legacy block")
        if [ -L "$target/$tgt" ]; then
          resolved="$(resolve_link "$target/$tgt")" \
            || finish_blocked "$tgt is a link that does not resolve to a file within eight links"
          case "$resolved" in
            "$target_physical"/*)
              rec_restore[i]="${resolved#"$target_physical"/}"
              require_committed "${rec_restore[i]}" "$tgt (a link resolving to ${rec_restore[i]})"
              ;;
            *) finish_blocked "$tgt is a link resolving to $resolved, outside the working tree, where git cannot restore it" ;;
          esac
        else
          require_committed "$tgt"
        fi
        ;;
      "legacy README")
        require_committed "${tgt%/*}/README.md"
        [ -e "$target/$tgt" ] && require_committed "$tgt"
        ;;
    esac
  done
fi

# --- Write, in manifest order. No rollback on failure. ---------------------
touched=""
note_touched() { touched="$touched  $1
"; }
import_lines=""
attention=""
add_attention() {
  if [ -z "$attention" ]; then attention="$1"; else attention="$attention, $1"; fi
}
finish_error() {
  printf '%s' "$import_lines"
  if [ -n "$touched" ]; then
    echo "Written before the failure:"
    printf '%s' "$touched"
  else
    echo "Written before the failure: nothing"
  fi
  echo "Outcome: ERROR"
  echo "Reason: $1"
  exit 1
}

# Replaces lines $2 to $3 of file $1 with record $4's block, through a
# temporary file beside it, keeping every other byte, the file's mode and a
# link at its path.
replace_block() {
  local f="$1" from="$2" to="$3" i="$4" tmp
  tmp="$(dirname "$f")/.project-update.$$"
  {
    [ "$from" -gt 1 ] && head -n "$((from - 1))" "$f"
    build_block "$i"
    tail -n "+$((to + 1))" "$f"
  } > "$tmp" 2>/dev/null || { rm -f "$tmp" 2>/dev/null; return 1; }
  # Past this point the target may be truncated, so a failure keeps the
  # temporary file: it is then the only full copy of the project's text.
  if ! cat "$tmp" > "$f" 2>/dev/null; then
    kept_copy="$tmp"
    return 1
  fi
  rm -f "$tmp"
}
kept_copy=""
replace_failed() {
  if [ -n "$kept_copy" ]; then
    finish_error "$1 could not be written; its full intended content is kept at $kept_copy"
  fi
  finish_error "$1 could not be written"
}

for i in "${!rec_name[@]}"; do
  name="${rec_name[$i]}"
  tgt="${rec_target[$i]}"
  tf="${rec_file[$i]}"
  version="${rec_version[$i]}"
  have="${rec_have[$i]}"
  case "${rec_state[$i]}" in
    current)
      echo "$name: current (version $have)"
      ;;
    stale)
      replace_block "$tf" "${rec_open[$i]}" "${rec_close[$i]}" "$i" \
        || replace_failed "$name: $tgt"
      note_touched "$tgt (a hashed block replaced: leave it; a re-run reports it current)"
      echo "$name: replaced (version $have → $version)"
      ;;
    "legacy block")
      replace_block "$tf" "${rec_open[$i]}" "${rec_close[$i]}" "$i" \
        || replace_failed "$name: $tgt"
      note_touched "${rec_restore[i]:-$tgt} (converted: git restore returns it)"
      echo "$name: converted from version $have to $version; not checked for edits, review with git diff"
      ;;
    "legacy README")
      dir="${tgt%/*}"
      if [ -f "$tf" ]; then
        { echo ""; build_block "$i"; } >> "$tf" 2>/dev/null \
          || finish_error "$name: could not append the block to $tgt"
        note_touched "$tgt (converted: git restore returns it)"
      else
        build_block "$i" > "$tf" 2>/dev/null || { rm -f "$tf" 2>/dev/null; finish_error "$name: $tgt could not be written"; }
        note_touched "$tgt (created: remove it)"
      fi
      dir_claude="$target/$dir/CLAUDE.md"
      if [ ! -e "$dir_claude" ] && [ ! -L "$dir_claude" ]; then
        printf '%s\n' '@AGENTS.md' > "$dir_claude" 2>/dev/null || finish_error "$name: $dir/CLAUDE.md could not be written"
        note_touched "$dir/CLAUDE.md (created: remove it)"
        import_lines="${import_lines}directory import: $dir/CLAUDE.md created holding @AGENTS.md
"
      elif ! { [ -f "$dir_claude" ] && grep -qxF '@AGENTS.md' "$dir_claude" 2>/dev/null; }; then
        import_lines="${import_lines}directory import: add the line @AGENTS.md to $dir/CLAUDE.md for $tgt to load
"
      fi
      rm -f "$target/$dir/README.md" 2>/dev/null || finish_error "$name: $dir/README.md could not be removed"
      note_touched "$dir/README.md (removed: git restore returns it)"
      echo "$name: converted from $dir/README.md to $tgt (version $version), README.md removed; not checked for edits, review with git diff"
      ;;
    edited)
      echo "$name: edited inside the markers (version $have, toolkit carries $version); not replaced"
      # The diff's two sides go outside the project, so a failure here leaves
      # nothing in it.
      scratch="$(mktemp -d "${TMPDIR:-/tmp}/project-update.XXXXXX")" \
        || finish_error "$name: no temporary directory for the diff"
      lines_between "$tf" "${rec_open[$i]}" "${rec_close[$i]}" > "$scratch/project"
      build_inner "$i" > "$scratch/toolkit"
      diff -u -L project -L toolkit "$scratch/project" "$scratch/toolkit" | sed 's/^/    /'
      rm -rf "$scratch"
      add_attention "$name"
      ;;
    ahead)
      echo "$name: ahead of this toolkit (version $have, toolkit carries $version); not replaced"
      add_attention "$name"
      ;;
    malformed)
      echo "$name: markers malformed in $tgt; not replaced"
      add_attention "$name"
      ;;
    "not writable")
      echo "$name: $tgt is not a path the tool writes into; nothing written"
      add_attention "$name"
      ;;
    "single file")
      echo "$name: present as the single file docs/backlog.md; convert it with $SCRIPT_DIR/backlog-migrate"
      add_attention "$name"
      ;;
    absent)
      echo "$name: absent; run $SCRIPT_DIR/project-init to write it"
      add_attention "$name"
      ;;
  esac
done

printf '%s' "$import_lines"
[ -n "$attention" ] && echo "Attention: $attention"
echo "Outcome: SUCCESS"
exit 0
