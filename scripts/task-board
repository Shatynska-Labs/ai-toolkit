}
CSS

cat > "$WORK/board.awk" <<'AWK'
function esc(s) {
  gsub(/&/, "\\&amp;", s); gsub(/</, "\\&lt;", s); gsub(/>/, "\\&gt;", s); gsub(/"/, "\\&quot;", s)
  return s
}
function pair(s, mark, before, after,   o, i, j) {
  o = ""
  while ((i = index(s, mark)) > 0) {
    j = index(substr(s, i + length(mark)), mark)
    if (!j) break
    o = o substr(s, 1, i - 1) before substr(s, i + length(mark), j - 1) after
    s = substr(s, i + length(mark) + j - 1 + length(mark))
  }
  return o s
}
function inline(s) { return pair(pair(esc(s), "`", "<code>", "</code>"), "**", "<strong>", "</strong>") }
function unquote(s,   o, i, c) {
  if (length(s) < 2 || substr(s, 1, 1) != "\"" || substr(s, length(s)) != "\"") return s
  s = substr(s, 2, length(s) - 2); o = ""
  for (i = 1; i <= length(s); i++) {
    c = substr(s, i, 1)
    if (c == "\\" && i < length(s)) { i++; c = substr(s, i, 1) }
    o = o c
  }
  return o
}
function tsv(file, kind,   l, f) {
  while ((getline l < file) > 0) {
    split(l, f, "\t")
    if (kind == "last") LAST[f[1]] = f[2]
    else { STAGE[f[1]] = f[2]; PROP[f[1]] = f[3]; CHG[f[1]] = f[4]; FLIGHT[++FL] = f[1] }
  }
  close(file)
}
function read_entry(n,   f, l, st, b, k, v) {
  f = ENVIRON["TB_TREE"] "/docs/backlog/" n ".md"
  st = 0; b = ""; EWS[n] = ""; EPRI[n] = "normal"
  while ((getline l < f) > 0) {
    sub(/\r$/, "", l)
    if (st == 0) { st = (l == "---") ? 1 : 2; if (st == 1) continue }
    if (st == 1) {
      if (l == "---") { st = 3; continue }
      k = l; sub(/:.*/, "", k); v = l; sub(/^[^:]*: */, "", v)
      if (k == "priority") EPRI[n] = v
      else if (k == "workstream") EWS[n] = v
      else if (k == "summary") ESUM[n] = unquote(v)
      else if (k == "waits_on") { gsub(/[\[\]]/, "", v); EWAIT[n] = v }
      continue
    }
    if (l != "") b = b "<p class=\"full\">" inline((l ~ /^- /) ? substr(l, 3) : l) "</p>\n"
  }
  close(f)
  if (st != 3) { ENOFM[n] = 1; W_N++ }
  if (EWS[n] == "none" || EWS[n] == "nothing") EWS[n] = ""
  EBODY[n] = b
}
function read_ws(i, n,   f, l, v, in_steps, s, q, name, desc) {
  f = ENVIRON["TB_TREE"] "/docs/workstreams/" n ".md"
  in_steps = 0; s = 0; q = ""
  while ((getline l < f) > 0) {
    sub(/\r$/, "", l)
    v = l; sub(/^- /, "", v)
    if (v ~ /^\*\*Goal\*\*:/) { sub(/^\*\*Goal\*\*: */, "", v); if (!(i in GOAL)) GOAL[i] = v }
    else if (v ~ /^\*\*Done when\*\*:/) { sub(/^\*\*Done when\*\*: */, "", v); if (!(i in DONEW)) DONEW[i] = v }
    else if (v ~ /^\*\*Summary\*\*:/) { sub(/^\*\*Summary\*\*: */, "", v); if (!(i in WSUM)) WSUM[i] = v }
    if (in_steps && l ~ /^(- \*\*|## )/) in_steps = 0
    if (v ~ /^\*\*Steps\*\*/) { in_steps = 1; continue }
    if (!in_steps || l !~ /^[0-9]+\. /) continue
    if (l ~ /^[0-9]+\. `[^`]+`/) {
      name = l; sub(/^[0-9]+\. `/, "", name); desc = name
      sub(/`.*/, "", name); sub(/^[^`]*`/, "", desc); sub(/^ *(—|-|:) */, "", desc)
      s++; SN[i, s] = name; SD[i, s] = desc
      TOWS[name] = (name in TOWS) ? TOWS[name] " " n : n
      STEP[name]++
    } else { q = q warn("a step line could not be read: " l); W_N++ }
  }
  close(f)
  NS[i] = s
  if (!s) { q = q warn("Its steps could not be read."); W_N++ }
  WWARN[i] = q
}
function warn(t) { return "<p class=\"warning\">Warning: " esc(t) "</p>\n" }
function ago(n,   d) {
  if (!(n in LAST)) return ""
  d = NOW - LAST[n]
  if (d < 3600) { d = int(d / 60); return (d < 1 ? 1 : d) " min" }
  if (d < 86400) return int(d / 3600) " h"
  return int(d / 86400) " d"
}
function unchecked(n) {
  return FORGE != "full" && !(n in OPEN) && !(n in ARCH)
}
function label(s) { return (s == "flight") ? "in flight" : s }
function cls(s) { return (s == "recorded") ? "" : s }
function row(n, desc, unplaced,   s, x, m) {
  s = status(n)
  x = "<span class=\"name\">" esc(n) "</span>"
  if (n in STAGE) x = x "<span class=\"stage-inline\">" esc(STAGE[n]) "</span>"
  if ((n in EPRI) && EPRI[n] != "normal") x = x "<span class=\"tag\">" esc(EPRI[n]) "</span>"
  if (unplaced) x = x "<span class=\"tag\">unplaced</span>"
  if (unchecked(n) || ((n in STAGE) && FORGE != "full")) x = x "<span class=\"mark\">merge not checked</span>"
  if (desc != "") x = x "<p class=\"desc\">" inline(desc) "</p>"
  if (n in ESUM) x = x "<p class=\"desc\">" inline(ESUM[n]) "</p>"
  if (n in EWAIT && EWAIT[n] != "") x = x "<p class=\"desc\">Waits on " esc(EWAIT[n]) "</p>"
  if (n in NOTE) x = x "<p class=\"desc\">Names " esc(NOTE[n]) ", which is not open</p>"
  if (n in ENOFM) x = x warn("no frontmatter")
  if ((n in STEP) && STEP[n] > 1) { x = x warn("also a step of another workstream"); W_N++ }
  m = "<span class=\"st " cls(s) "\">" label(s) "</span><div>" x "</div><span class=\"ago\">" ago(n) "</span>"
  if (n in EBODY)
    return "<li class=\"step\"><details class=\"task\"><summary>" m "<span class=\"more\"></span></summary>\n" EBODY[n] "</details></li>\n"
  return "<li class=\"step rowgrid\">" m "<span></span></li>\n"
}
function head() {
  return "<li class=\"rowgrid rowhead\"><span>Status</span><span>Task</span><span>Last commit</span><span>Details</span></li>\n"
}
function group(i,   n, j, o, bar, d, f, x, m) {
  n = WN[i]; d = 0; f = 0; bar = ""; o = ""
  for (j = 1; j <= NS[i]; j++) {
    x = status(SN[i, j]); bar = bar "<u class=\"" cls(x) "\"></u>"
    if (x == "done") d++
    if (x == "flight") f++
    o = o row(SN[i, j], SD[i, j], 0)
  }
  for (j = 1; j <= NX[i]; j++) {
    if (status(XN[i, j]) == "flight") f++
    o = o row(XN[i, j], "", 1)
  }
  m = d " of " NS[i] " done"
  if (f) m = m ", " f " in work"
  return "<details class=\"group\" id=\"" esc(n) "\"><summary><span class=\"chev\" aria-hidden=\"true\">▶</span><div><div class=\"name\">" esc(n) "</div>" \
    ((i in WSUM) ? "<div class=\"sub\">" inline(WSUM[i]) "</div>" : "") \
    "</div><div class=\"progress\"><div class=\"bar\">" bar "</div><span>" m "</span></div></summary>\n<div class=\"body\">\n" \
    "<p class=\"def\"><strong>Goal:</strong> " inline(GOAL[i]) "</p>\n<p class=\"def\"><strong>Done when:</strong> " inline(DONEW[i]) "</p>\n" \
    WWARN[i] "<ol class=\"steps\">\n" head() o "</ol>\n</div></details>\n"
}
function links(n,   a, c, i, o) {
  o = ""
  if (n in TOWS) { c = split(TOWS[n], a, " "); for (i = 1; i <= c; i++) o = o "<a href=\"#" esc(a[i]) "\">" esc(a[i]) "</a>" }
  else if (n in PLACED) o = "<a href=\"#" esc(PLACED[n]) "\">" esc(PLACED[n]) "</a>"
  return o
}
function flightrow(n,   s, t, p, l, q) {
  s = STAGE[n]; t = ""
  if (n in STEP) t = t "<span class=\"tag\">step</span>"
  if (n in ENT) t = t "<span class=\"tag\">entry</span>"
  if (CHG[n] == "yes") t = t "<span class=\"tag\">change</span>"
  if (n in BR) t = t "<span class=\"tag\">branch</span>"
  if (n in PRO) t = t "<span class=\"tag\">open PR</span>"
  if (n in PRM) t = t "<span class=\"tag\">merged PR</span>"
  if ((n in PLACED) && !(n in STEP)) t = t "<span class=\"tag\">unplaced</span>"
  p = (s ~ /^plan/) ? "<i class=\"on\"></i><i></i><i></i>" : (s ~ /^build/) ? "<i class=\"past\"></i><i class=\"on\"></i><i></i>" : (s ~ /^ship/) ? "<i class=\"past\"></i><i class=\"past\"></i><i class=\"on\"></i>" : "<i></i><i></i><i></i>"
  q = (FORGE != "full") ? "<span class=\"mark\">pull requests not checked</span>" : ""
  l = links(n)
  return "<div class=\"work\"><div><div class=\"name\">" esc(n) "</div>" \
    ((n in ESUM) ? "<div class=\"sub\">" inline(ESUM[n]) "</div>" : "") \
    "<div class=\"tags\">" t "</div></div><div><div class=\"pipe\">" p "</div><span class=\"stage\">" esc(s) "</span>" q "</div>" \
    "<div class=\"ago\">" ago(n) "</div>" \
    ((l != "") ? "<div class=\"ws\">" l "</div>" : "<div class=\"ws none\">no workstream</div>") "</div>\n"
}
function later(a, b,   x, y) {   # a sorts after b, newest first
  x = (a in LAST) ? LAST[a] + 0 : 0; y = (b in LAST) ? LAST[b] + 0 : 0
  if (x != y) return x < y
  return a > b
}
function looser(a, b,   x, y) {   # a sorts after b in the group of tasks in no workstream
  x = (status(a) == "flight") ? 0 : ((a in EPRI) && EPRI[a] == "parked") ? 2 : 1
  y = (status(b) == "flight") ? 0 : ((b in EPRI) && EPRI[b] == "parked") ? 2 : 1
  if (x != y) return x > y
  return later(a, b)
}
function place(n,   pw, ew, w, x) {
  if (n in SEEN) return
  SEEN[n] = 1
  if (n in STEP) return
  pw = (n in PROP) ? PROP[n] : ""
  ew = (n in EWS) ? EWS[n] : ""
  w = (pw in WSI) ? pw : (ew in WSI) ? ew : ""
  if (w != "") { PLACED[n] = w; x = WSI[w]; XN[x, ++NX[x]] = n; return }
  if (pw != "") NOTE[n] = pw
  else if (ew != "") NOTE[n] = ew
  LOOSE[++NL] = n
}
function isort(a, c, how,   i, j, v, after) {
  for (i = 2; i <= c; i++) {
    v = a[i]; j = i - 1
    while (j >= 1) {
      after = (how == "new") ? later(a[j], v) : looser(a[j], v)
      if (!after) break
      a[j + 1] = a[j]; j--
    }
    a[j + 1] = v
  }
}
function loadlist(file, a,   l, c) {
  c = 0
  while ((getline l < file) > 0) a[++c] = l
  close(file)
  return c
}
function copy(file,   l) { while ((getline l < file) > 0) print l; close(file) }
BEGIN {
  sets()
  FORGE = ENVIRON["TB_FORGE"]; NOW = ENVIRON["TB_NOW"] + 0
  tsv(W "/last-trunk", "last"); tsv(W "/last-branch", "last")
  FL = 0; tsv(W "/flight-info", "flight")
  NW = loadlist(W "/workstreams", WN)
  for (i = 1; i <= NW; i++) { WSI[WN[i]] = i; NX[i] = 0 }
  for (i = 1; i <= NW; i++) read_ws(i, WN[i])
  c = loadlist(W "/entries", EL)
  for (i = 1; i <= c; i++) read_entry(EL[i])
  NL = 0
  for (i = 1; i <= c; i++) place(EL[i])
  c = loadlist(W "/open", OL)
  for (i = 1; i <= c; i++) place(OL[i])
  for (i = 1; i <= FL; i++) place(FLIGHT[i])
  isort(LOOSE, NL, "loose")
  isort(FLIGHT, FL, "new")
  for (i = 1; i <= NW; i++) {
    act = 0
    for (j = 1; j <= NS[i]; j++) if (status(SN[i, j]) == "flight") act = 1
    for (j = 1; j <= NX[i]; j++) if (status(XN[i, j]) == "flight") act = 1
    ACTIVE[i] = act
  }
  a = ""; o = ""; na = 0; no = 0
  for (i = 1; i <= NW; i++) {
    g_ = group(i)
    if (ACTIVE[i]) { a = a g_; na++ } else { o = o g_; no++ }
  }
  p = esc(ENVIRON["TB_PROJECT"])
  print "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">"
  print "<title>" p " tasks</title>\n<style>"
  copy(W "/style.css")
  print "</style></head><body><main>"
  print "<header><h1>" p "</h1><p class=\"meta\">Written " esc(ENVIRON["TB_WHEN"]) ", from " esc(ENVIRON["TB_TRUNK"]) " " esc(ENVIRON["TB_SHA"]) ".</p></header>"
  n = ENVIRON["TB_NOTICES"]
  if (n != "") { c = split(n, nt, "|"); print "<div class=\"notice\">"; for (i = 1; i <= c; i++) print "<span>" esc(nt[i]) "</span>"; print "</div>" }
  print "<section><h2>In work (" FL ")</h2>"
  if (FL) {
    print "<div class=\"list\"><div class=\"work workhead\"><span>Task</span><span>Stage</span><span>Last commit</span><span>Workstream</span></div>"
    for (i = 1; i <= FL; i++) printf "%s", flightrow(FLIGHT[i])
    print "</div>"
  } else print "<p class=\"meta\">Nothing is in flight.</p>"
  print "<p class=\"meta\">A session's own status report is finer than these stages.</p></section>"
  if (NW) {
    print "<section><h2>Active workstreams (" na ")</h2>"
    if (na) printf "<div class=\"groups\">\n%s</div>\n", a
    else print "<p class=\"meta\">No workstream is active.</p>"
    print "<div class=\"legend\"><span class=\"st done\">done</span><span class=\"st flight\">in flight</span><span class=\"st\">recorded</span><span class=\"st planned\">planned</span></div></section>"
  }
  if (no) {
    print "<section><h2>Other workstreams (" no ")</h2><details class=\"group\"><summary><span class=\"chev\" aria-hidden=\"true\">▶</span><div><div class=\"name\">" no " workstream" (no == 1 ? "" : "s") "</div><div class=\"sub\">Nothing in work right now</div></div><span></span></summary>"
    printf "<div class=\"body\"><div class=\"groups\">\n%s</div></div></details></section>\n", o
  }
  if (NL) {
    print "<section><h2>Not in a workstream</h2><details class=\"group\"" (NW ? "" : " open") "><summary><span class=\"chev\" aria-hidden=\"true\">▶</span><div><div class=\"name\">" NL " task" (NL == 1 ? "" : "s") "</div></div><span></span></summary>"
    print "<div class=\"body\"><ul class=\"steps\">"
    printf "%s", head()
    for (i = 1; i <= NL; i++) printf "%s", row(LOOSE[i], "", 0)
    print "</ul></div></details></section>"
  }
  print "</main></body></html>"
  print W_N + 0 > (W "/warnings")
}
AWK

SHA="$(g rev-parse --short "$TRUNK")"
NOTICES=""
notice() { NOTICES="${NOTICES:+$NOTICES|}$1"; }
if [ "$HAS_ORIGIN" = no ]; then
  TRUNK_LINE="$TRUNK_NAME $SHA, the current branch: no remote named origin"
  notice "No remote named origin: read the current branch, $TRUNK_NAME."
elif [ "$FETCHED" = yes ]; then
  TRUNK_LINE="$TRUNK $SHA, fetched"
else
  TRUNK_LINE="$TRUNK $SHA, the fetch failed and it may be stale"
  notice "The trunk may be stale: the fetch failed."
fi
if [ "$REMOTE_READ" = yes ]; then
  REMOTE_LINE="read"
else
  REMOTE_LINE="not read"
  notice "Remote branches not read."
fi
case "$FORGE" in
  full) FORGE_LINE="read in full" ;;
  partly)
    FORGE_LINE="partly read, the first $PR_LIMIT pull requests"
    notice "Forge partly read: the first $PR_LIMIT pull requests." ;;
  *)
    FORGE_LINE="not reached"
    notice "Forge not reached: merged pull requests could not be checked." ;;
esac

TB_NOW="$(date +%s)"
TB_WHEN="$(date '+%Y-%m-%d %H:%M')"
export TB_NOTICES="$NOTICES" TB_SHA="$SHA" TB_NOW TB_WHEN

write_failed() {
  echo "Outcome: ERROR"
  echo "Reason: $OUTPUT could not be written"
  [ -s "$WORK/errors" ] && head -n 3 "$WORK/errors"
  exit 1
}

if [ -d "$OUTPUT" ]; then write_failed; fi
PAGE_TMP="$OUTPUT.$$.tmp"
{ : > "$PAGE_TMP"; } 2>/dev/null || write_failed
awk -f "$WORK/common.awk" -f "$WORK/board.awk" > "$PAGE_TMP" 2>"$WORK/errors" </dev/null || write_failed
mv -f "$PAGE_TMP" "$OUTPUT" 2>/dev/null || write_failed
PAGE_TMP=""

echo "Board: $OUTPUT"
echo "Trunk: $TRUNK_LINE"
echo "Remote branches: $REMOTE_LINE"
echo "Forge: $FORGE_LINE"
echo "Warnings: $(cat "$WORK/warnings")"
echo "Outcome: SUCCESS"
