#!/usr/bin/env bash
# Writes one self-contained HTML page of one project's tasks, read from its
# trunk. See `--help` for usage; see tests/README.md for the report contract
# this script implements against. The status lookups in status() below are the
# ones rules/workstreams.md states, in its order: change them together.
set -u

# Inherited from a hook or wrapper, these would point every git call below at
# the caller's repository instead of the target.
if command -v git >/dev/null 2>&1; then
  # shellcheck disable=SC2046 # word splitting is intended: one name per word
  unset $(git rev-parse --local-env-vars 2>/dev/null)
fi
unset GIT_DIR GIT_WORK_TREE GIT_COMMON_DIR GIT_INDEX_FILE
export GIT_TERMINAL_PROMPT=0 GIT_OPTIONAL_LOCKS=0

PR_LIMIT=5000

print_help() {
  cat <<'HELP'
task-board — write one HTML page of a project's tasks

Usage:
  task-board [--help|-h] [--output FILE] [TARGET_DIR]

Shows what is in flight and at what stage, each open workstream with its steps,
and every task no workstream holds. Everything is read from the trunk as
fetched, except a task in flight, whose change is read from its branch.
Status is derived and never stored.

Arguments:
  TARGET_DIR      The project. Defaults to the current working directory.

Flags:
  --output FILE   Where to write the page. Defaults to
                  task-board-<project>.html in the temporary directory.
  --help, -h      Show this help and exit. Writes nothing.

Outcomes and exit codes:
  0   SUCCESS   the page was written
  1   ERROR     the page could not be written
  2   BLOCKED   a precondition was unmet; no page was written

Changes nothing in the project but what `git fetch` brings in. Uses `gh` where
it can; without it the page says the forge was not reached.
HELP
}

# --- Arguments. -------------------------------------------------------------
TARGET=""
OUTPUT=""
while [ $# -gt 0 ]; do
  case "$1" in
    --help|-h) print_help; exit 0 ;;
    --output)
      if [ $# -lt 2 ]; then echo "Outcome: BLOCKED"; echo "Reason: --output needs a file"; exit 2; fi
      OUTPUT="$2"; shift ;;
    --output=*) OUTPUT="${1#--output=}" ;;
    -*) echo "Outcome: BLOCKED"; echo "Reason: unknown flag $1"; exit 2 ;;
    *)
      if [ -n "$TARGET" ]; then echo "Outcome: BLOCKED"; echo "Reason: more than one target"; exit 2; fi
      TARGET="$1" ;;
  esac
  shift
done
[ -n "$TARGET" ] || TARGET="."

block() {
  echo "Outcome: BLOCKED"
  echo "Reason: $1"
  exit 2
}

GIVEN="$TARGET"
if ! TARGET="$(cd "$GIVEN" 2>/dev/null && pwd -P)"; then
  echo "Target: $GIVEN"
  block "the target is not a directory"
fi
echo "Target: $TARGET"

ROOT=""
g() { git -C "${ROOT:-$TARGET}" "$@"; }

command -v git >/dev/null 2>&1 || block "git is not installed"
g rev-parse --git-dir >/dev/null 2>&1 || block "the target is not a Git repository"
# Every path below is from the top of the repository, wherever the target sits in it.
ROOT="$(g rev-parse --show-toplevel 2>/dev/null)" || ROOT=""
[ -n "$ROOT" ] || block "the target has no working tree, as in a bare repository"

# --- The trunk. --------------------------------------------------------------
FETCHED=yes
HAS_ORIGIN=no
if g remote get-url origin >/dev/null 2>&1; then
  HAS_ORIGIN=yes
  g -c fetch.prune=false fetch --quiet --no-prune origin >/dev/null 2>&1 || FETCHED=no
fi

if [ "$HAS_ORIGIN" = yes ]; then
  TRUNK="$(g symbolic-ref -q --short refs/remotes/origin/HEAD 2>/dev/null || true)"
  if [ -n "$TRUNK" ] && ! g rev-parse -q --verify "$TRUNK^{commit}" >/dev/null 2>&1; then TRUNK=""; fi
  if [ -z "$TRUNK" ]; then
    for candidate in origin/main origin/master; do
      if g rev-parse -q --verify "$candidate^{commit}" >/dev/null 2>&1; then TRUNK="$candidate"; break; fi
    done
  fi
  if [ -z "$TRUNK" ]; then
    g rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1 || block "the repository has no commit"
    block "no trunk could be resolved from origin"
  fi
  TRUNK_NAME="${TRUNK#origin/}"
else
  g rev-parse -q --verify 'HEAD^{commit}' >/dev/null 2>&1 || block "the repository has no commit"
  TRUNK="HEAD"
  TRUNK_NAME="$(g rev-parse --abbrev-ref HEAD)"
fi

on_trunk() { g cat-file -e "$TRUNK:$1" 2>/dev/null; }

if ! on_trunk docs/backlog && on_trunk docs/backlog.md; then
  block "the backlog is the single file docs/backlog.md; convert it with scripts/backlog-migrate"
fi
if ! on_trunk docs/backlog && ! on_trunk docs/workstreams; then
  block "the trunk holds neither docs/backlog/ nor docs/workstreams/; scripts/project-init writes them"
fi

# --- The page's path. --------------------------------------------------------
COMMON="$(g rev-parse --git-common-dir)"
case "$COMMON" in /*) ;; *) COMMON="$ROOT/$COMMON" ;; esac
PROJECT="$(basename "$(cd "$COMMON/.." && pwd -P)")"
[ -n "$OUTPUT" ] || OUTPUT="${TMPDIR:-/tmp}/task-board-$PROJECT.html"

if ! WORK="$(mktemp -d "${TMPDIR:-/tmp}/task-board.XXXXXX")"; then
  echo "Outcome: ERROR"
  echo "Reason: no temporary directory could be made"
  exit 1
fi
PAGE_TMP=""
trap 'rm -rf "$WORK"; if [ -n "$PAGE_TMP" ]; then rm -f "$PAGE_TMP"; fi' EXIT

error() {
  echo "Outcome: ERROR"
  echo "Reason: $1"
  exit 1
}

# --- A snapshot of the trunk. ------------------------------------------------
mkdir -p "$WORK/tree"
PATHS=""
for path in docs/backlog docs/workstreams openspec/changes; do
  if on_trunk "$path"; then PATHS="$PATHS $path"; fi
done
# Through an index of its own rather than `git archive`, which honours export-ignore.
GIT_INDEX_FILE="$WORK/index" g read-tree "$TRUNK" || error "the trunk could not be read"
# shellcheck disable=SC2086 # word splitting is intended: the paths hold no spaces
GIT_INDEX_FILE="$WORK/index" g ls-files -z -- $PATHS > "$WORK/paths" || error "the trunk could not be read"
GIT_INDEX_FILE="$WORK/index" g checkout-index -z --stdin --prefix="$WORK/tree/" < "$WORK/paths" \
  || error "the trunk could not be read"
TREE="$WORK/tree"

# --- The name sets, one sorted file each. ------------------------------------
names_of() { [ -d "$1" ] && find "$1" -mindepth 1 -maxdepth 1 "${@:2}" -print | sed 's#.*/##'; }

{ names_of "$TREE/openspec/changes/archive" -type d | sed 's/^[0-9]\{4\}-[0-9][0-9]-[0-9][0-9]-//'; } | LC_ALL=C sort -u > "$WORK/archived"
{ names_of "$TREE/openspec/changes" -type d | grep -vx archive; } | LC_ALL=C sort -u > "$WORK/open"
{ names_of "$TREE/docs/backlog" -type f -name '*.md' | sed 's/\.md$//' | grep -vxE 'AGENTS|CLAUDE|README'; } | LC_ALL=C sort -u > "$WORK/entries"
{ names_of "$TREE/docs/workstreams" -type f -name '*.md' | sed 's/\.md$//' | grep -vxE 'AGENTS|CLAUDE|README'; } | LC_ALL=C sort -u > "$WORK/workstreams"

not_trunk() { grep -vxF -e "$TRUNK_NAME" -e main -e master; }

g for-each-ref --format='%(refname)' refs/heads | sed 's#^refs/heads/##' | not_trunk | LC_ALL=C sort -u > "$WORK/local"
REMOTE_READ=no
: > "$WORK/remote"
if [ "$HAS_ORIGIN" = yes ] && listed="$(g ls-remote --heads origin 2>/dev/null)"; then
  REMOTE_READ=yes
  printf '%s\n' "$listed" | sed -n 's#.*refs/heads/##p' | not_trunk | LC_ALL=C sort -u > "$WORK/remote"
fi
LC_ALL=C sort -u "$WORK/local" "$WORK/remote" > "$WORK/branches"

FORGE=none
: > "$WORK/prs"
if command -v gh >/dev/null 2>&1; then
  # shellcheck disable=SC2016 # the template is gh's, not the shell's
  if ( cd "${ROOT:-$TARGET}" && gh pr list --state all --limit "$PR_LIMIT" --json headRefName,state \
      --template '{{range .}}{{.headRefName}}{{"\t"}}{{.state}}{{"\n"}}{{end}}' ) > "$WORK/prs" 2>/dev/null; then
    FORGE=full
    if [ "$(wc -l < "$WORK/prs")" -ge "$PR_LIMIT" ]; then FORGE=partly; fi
  else
    : > "$WORK/prs"
  fi
fi
awk -F'\t' '$2 == "OPEN" { print $1 }' "$WORK/prs" | not_trunk | LC_ALL=C sort -u > "$WORK/prs-open"
awk -F'\t' '$2 == "MERGED" { print $1 }' "$WORK/prs" | LC_ALL=C sort -u > "$WORK/prs-merged"

# --- The last commit of each name. -------------------------------------------
g -c core.quotePath=false log --format='@@%ct' --name-only "$TRUNK" -- docs/backlog openspec/changes | awk '
  /^@@/ { t = substr($0, 3); next }
  /^docs\/backlog\/[^\/]+\.md$/ { n = $0; sub(/^docs\/backlog\//, "", n); sub(/\.md$/, "", n) }
  /^openspec\/changes\/archive\/[^\/]+\// { n = $0; sub(/^openspec\/changes\/archive\//, "", n); sub(/\/.*/, "", n); sub(/^[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-/, "", n) }
  /^openspec\/changes\/[^\/]+\// { if ($0 !~ /^openspec\/changes\/archive\//) { n = $0; sub(/^openspec\/changes\//, "", n); sub(/\/.*/, "", n) } }
  n != "" { if (!(n in seen)) { seen[n] = 1; print n "\t" t }; n = "" }
' > "$WORK/last-trunk"

g for-each-ref --no-merged "$TRUNK" --format='%(committerdate:unix) %(refname)' refs/heads refs/remotes/origin | awk -v listed="$WORK/remote" '
  BEGIN { while ((getline l < listed) > 0) on[l] = 1 }
  {
    n = $2
    if (n ~ /^refs\/heads\//) sub(/^refs\/heads\//, "", n)
    else { sub(/^refs\/remotes\/origin\//, "", n); if (!(n in on)) next }
    if (!(n in t) || $1 > t[n]) t[n] = $1
  }
  END { for (n in t) print n "\t" t[n] }
' > "$WORK/last-branch"

# --- What is in flight, and what its branch says. -----------------------------
export TB_WORK="$WORK" TB_TREE="$TREE" TB_PROJECT="$PROJECT" TB_TRUNK="$TRUNK" TB_FORGE="$FORGE"

cat > "$WORK/common.awk" <<'AWK'
function load(file, into,   l) {
  while ((getline l < file) > 0) into[l] = 1
  close(file)
}
function sets() {
  W = ENVIRON["TB_WORK"]
  load(W "/archived", ARCH); load(W "/open", OPEN); load(W "/entries", ENT)
  load(W "/branches", BR); load(W "/prs-open", PRO); load(W "/prs-merged", PRM)
}
# The lookups of rules/workstreams.md, in its order.
function status(n) {
  if ((n in ARCH) || (!(n in OPEN) && (n in PRM))) return "done"
  if ((n in OPEN) || (n in BR) || (n in PRO)) return "flight"
  if (n in ENT) return "recorded"
  return "planned"
}
AWK

cat > "$WORK/flight.awk" <<'AWK'
BEGIN { sets() }
status($0) == "flight"
AWK

# A branch or pull request is a task only under a one-word kebab-case name; a
# change, an entry or a step is one whatever its name.
LC_ALL=C sort -u "$WORK/branches" "$WORK/prs-open" | grep -xE '[a-z0-9]+(-[a-z0-9]+)*' > "$WORK/kebab"
while IFS= read -r name; do
  awk '
    /^(- )?\*\*Steps\*\*/ { on = 1; next }
    on && /^(- \*\*|## )/ { on = 0 }
    on && /^[0-9]+\. `[^`]+`/ { n = $0; sub(/^[0-9]+\. `/, "", n); sub(/`.*/, "", n); print n }
  ' "$TREE/docs/workstreams/$name.md"
done < "$WORK/workstreams" > "$WORK/steps"
LC_ALL=C sort -u "$WORK/open" "$WORK/entries" "$WORK/steps" "$WORK/kebab" \
  | awk -f "$WORK/common.awk" -f "$WORK/flight.awk" > "$WORK/flight"

first_copy() {
  # first_copy NAME FILE: the file from the first place that holds it.
  local ref
  for ref in "refs/heads/$1" "$REMOTE_REF" "$TRUNK"; do
    [ -n "$ref" ] || continue
    if g show "$ref:openspec/changes/$1/$2" 2>/dev/null; then return 0; fi
  done
  return 1
}

in_set() { grep -qxF -- "$1" "$WORK/$2"; }

while IFS= read -r name; do
  REMOTE_REF=""
  if in_set "$name" remote && g rev-parse -q --verify "refs/remotes/origin/$name" >/dev/null 2>&1; then
    REMOTE_REF="refs/remotes/origin/$name"
  fi
  proposal="$(first_copy "$name" proposal.md)"; has_proposal=$?
  tasks="$(first_copy "$name" tasks.md)" || tasks=""
  # shellcheck disable=SC2016 # the backticks are the text being matched
  ws="$(printf '%s\n' "$proposal" | sed -n 's/^\(- \)\{0,1\}\*\*Workstream\*\*:[^`]*`\([^`]*\)`.*/\2/p' | head -n 1)"
  case "$ws" in none|nothing) ws="" ;; esac
  ticked="$(printf '%s\n' "$tasks" | grep -c '^- \[[xX]\]')"
  waiting="$(printf '%s\n' "$tasks" | grep -c '^- \[ \]')"
  if in_set "$name" open && in_set "$name" prs-merged; then stage="ship:merged"
  elif in_set "$name" prs-open; then stage="ship:pr-open"
  elif in_set "$name" remote && [ -z "$REMOTE_REF" ] && ! in_set "$name" local && ! in_set "$name" open; then stage="unknown"
  elif [ "$ticked" -gt 0 ]; then stage="build:applying $ticked/$((ticked + waiting))"
  elif [ "$has_proposal" -eq 0 ]; then stage="plan:drafting"
  else stage="plan:exploring"
  fi
  change=no
  if in_set "$name" open || [ "$has_proposal" -eq 0 ]; then change=yes; fi
  printf '%s\t%s\t%s\t%s\n' "$name" "$stage" "$ws" "$change"
done < "$WORK/flight" > "$WORK/flight-info"

# --- The page. ---------------------------------------------------------------
cat > "$WORK/style.css" <<'CSS'
:root {
  --bg: #f5f7f8; --panel: #ffffff; --fg: #18242b; --muted: #5c6c75; --line: #d9e0e4;
  --done: #2f7d5b; --work: #1f63c4; --work-soft: #e2ecfa; --warn: #a3620c; --warn-soft: #f8ecd8;
  --mono: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
  --sans: system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
}
@media (prefers-color-scheme: dark) { :root {
  --bg: #12191e; --panel: #1a242a; --fg: #e4ebee; --muted: #93a3ac; --line: #2e3c44;
  --done: #5bb78f; --work: #7fb0f5; --work-soft: #1f3250; --warn: #e3a955; --warn-soft: #3c2e17; color-scheme: dark } }
